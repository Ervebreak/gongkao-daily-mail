RUN_MODE=prod
TIMEZONE=Asia/Shanghai
MAX_ARTICLES=6
LOOKBACK_DAYS=3
SEND_EMAIL=true
ATTACH_DAILY_PDF=false
ENABLE_WEEKLY_PDF=false
DAILY_ARCHIVE_ENABLED=true
OFFICIAL_SEND_HOUR=7
OFFICIAL_SEND_MINUTE=20
OFFICIAL_ARCHIVE_WINDOW_MINUTES=45
DAILY_ARCHIVE_PREFIX=gongkao-morning-mailer/daily
HISTORY_WRITE_OFFICIAL_ONLY=true
HISTORY_STORAGE=local
CANDIDATE_STORAGE=local
CANDIDATE_PREFIX=gongkao-morning-mailer/candidates
HARNESS_METRICS_ENABLED=true
HARNESS_METRICS_FILE=harness_metrics.jsonl
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_KEY=gongkao-morning-mailer/sent_history.json
BLOCK_TITLES=
BLOCK_URLS=

DASHSCOPE_API_KEY=你的百炼API_KEY
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus-2025-07-14
QWEN_MODEL=qwen-plus-2025-07-14
LLM_FALLBACK_MODEL=qwen-plus

# A/B 分阶段模型：A 负责选文章，B 负责写邮件；不填则默认回退到 LLM_MODEL
SELECTION_LLM_MODEL=qwen-plus
# SELECTION_LLM_FALLBACK_MODEL=qwen-turbo
WRITING_LLM_MODEL=qwen3.6-plus
# WRITING_LLM_FALLBACK_MODEL=qwen-plus


SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的QQ邮箱SMTP授权码
MAIL_FROM=你的QQ邮箱@qq.com
RECIPIENTS=收件人1@qq.com,收件人2@qq.com
TEST_RECIPIENTS=你的测试邮箱@qq.com
ADMIN_REPORT_ENABLED=true
ADMIN_REPORT_SEND_EMAIL=true
ADMIN_REPORT_EMAILS=你的管理员邮箱@qq.com
SUBSCRIBERS_STORAGE=local
SUBSCRIBERS_OSS_KEY=gongkao-morning-mailer/subscribers.csv
SEND_MODE=bcc
FEEDBACK_BASE_URL=
FEEDBACK_PREFIX=gongkao-morning-mailer/feedback
MAIL_SUBJECT_PREFIX=【公考晨读】

# 手动测试函数 {"mode":"test"} 时优先使用的低成本模型；填 mock 可完全跳过大模型调用
TEST_LLM_MODEL=qwen-plus
# TEST_LLM_FALLBACK_MODEL=qwen-turbo
# 如需在测试模式下分别指定选文模型 / 写稿模型，可单独设置；未设置则回退到 TEST_LLM_MODEL
TEST_SELECTION_LLM_MODEL=qwen-plus
# TEST_SELECTION_LLM_FALLBACK_MODEL=qwen-turbo
TEST_WRITING_LLM_MODEL=qwen-plus
# TEST_WRITING_LLM_FALLBACK_MODEL=qwen-turbo


# 抓取/筛选池控制：栏目定向抓取后建议保留较大栏目池，再由规则和大模型筛选
COLUMN_MAX_CANDIDATES=80
SOURCE_POOL_MAX=240
LLM_SELECTION_POOL_MAX=90
LLM_ARTICLE_BODY_PARAGRAPHS=4
LLM_ARTICLE_PARAGRAPH_CHARS=180

# 两阶段大模型：先选文章，再用更完整主线文章生成邮件
LLM_TWO_STAGE_ENABLED=true
FEATURED_ARTICLE_MAX_CHARS=8000
QUICK_READ_ARTICLE_MAX_CHARS=1800

# 质量检查后，是否对不合格的“今日一题/文章框架图”定点重写一次
QUALITY_REWRITE_ENABLED=true
QUALITY_REWRITE_MAX_ROUNDS=1

# Optional Shenlun question-bank context for daily question generation.
# If reading fails, keep sending and fall back to the old daily-question logic.
QUESTION_BANK_ENABLED=true
QUESTION_BANK_SOURCE=local
QUESTION_BANK_LOCAL_PATH=data/question_bank/shenlun_question_bank_v3_a.csv
QUESTION_BANK_OSS_KEY=question_bank/shenlun_question_bank_v3_a.csv
QUESTION_BANK_MATCH_LIMIT=3
QUESTION_BANK_RECENT_DAYS_DEDUP=7
QUESTION_BANK_FAIL_OPEN=true

# 分阶段超时（秒）：写稿阶段更重，建议放宽
LLM_TIMEOUT=120
LLM_SELECTION_TIMEOUT=90
LLM_WRITING_TIMEOUT=180
